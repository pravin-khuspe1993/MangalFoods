@page "/about"
@model MangalFoods.Pages.AboutModel

<section class="py-4 py-lg-5">
    <div class="container-xl">
        <h1 class="h2 mb-3">Our Story</h1>
        <p class="lead text-muted">We craft premium Indian sweets and savouries with modern elegance and authentic flavors.</p>
        <div class="row g-4 mt-1">
            <div class="col-lg-6">
                <img src="/images/brand/about-story.webp" class="img-fluid rounded-4 shadow-sm" alt="Artisanal sweets preparation" loading="lazy" />
            </div>
            <div class="col-lg-6">
                <h2 class="h4">Tradition with contemporary finesse</h2>
                <p>Our collection is inspired by regional recipes, thoughtful ingredients, and a gifting-first presentation style.</p>
                <h2 class="h4">Crafted for celebrations</h2>
                <p>From personal milestones to festive occasions and corporate moments, each box is designed to feel meaningful.</p>
            </div>
        </div>
    </div>
</section>
