<section class="product-filters" aria-labelledby="filters-heading">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 id="filters-heading" class="h6 mb-0">Filters</h2>
        <button type="button" class="btn btn-outline-dark btn-sm d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#mobileFilters" aria-controls="mobileFilters">Open Filters</button>
    </div>

    <div class="d-none d-lg-block filter-panel p-3 rounded-4">
        <partial name="Partials/_ProductFiltersBody" />
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileFilters" aria-labelledby="mobileFiltersLabel">
        <div class="offcanvas-header">
            <h3 class="offcanvas-title h5" id="mobileFiltersLabel">Filter Products</h3>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close filters"></button>
        </div>
        <div class="offcanvas-body">
            <partial name="Partials/_ProductFiltersBody" />
        </div>
    </div>
</section>
