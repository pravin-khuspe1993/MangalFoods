@page "/product/{slug}"
@model MangalFoods.Pages.ProductModel
@{
    var product = Model.Product;
    var discount = product is not null && product.OriginalPrice > product.Price && product.OriginalPrice > 0
        ? (int)Math.Round((product.OriginalPrice - product.Price) / product.OriginalPrice * 100)
        : 0;
}

@if (product is null)
{
    <section class="py-5"><div class="container-xl"><h1 class="h3">Product not found</h1></div></section>
}
else
{
    <section class="py-4 py-lg-5">
        <div class="container-xl">
            <div class="row g-4 g-lg-5">
                <div class="col-lg-6 reveal reveal-left image-reveal">
                    <img id="productMainImage" src="@(product.Images.FirstOrDefault() ?? "/images/products/placeholder-product.webp")" class="img-fluid rounded-4 shadow-sm product-main-image" alt="@product.Name" loading="lazy" />
                    @if (product.Images.Count > 1)
                    {
                        <div class="row g-2 mt-2 product-thumbnails reveal-stagger">
                            @foreach (var image in product.Images.Skip(1))
                            {
                                <div class="col-4">
                                    <button type="button" class="btn p-0 border-0 bg-transparent product-thumb-button" data-product-thumb="@image" aria-label="View alternate image of @product.Name">
                                        <img src="@image" class="img-fluid rounded-3" alt="@product.Name alternate view" loading="lazy" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="col-lg-6">
                    <h1 class="h2 mb-2 reveal reveal-up" style="transition-delay: 40ms;">@product.Name</h1>
                    <p class="mb-2 rating-text reveal reveal-up" style="transition-delay: 110ms;">★ @product.Rating.ToString("0.0")</p>
                    <div class="mb-3 reveal reveal-up" style="transition-delay: 180ms;">
                        <span class="h4">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-IN"), "₹{0:N0}", product.Price)</span>
                        @if (product.OriginalPrice > product.Price)
                        {
                            <span class="text-muted text-decoration-line-through ms-2">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-IN"), "₹{0:N0}", product.OriginalPrice)</span>
                            <span class="text-success ms-2">@discount% off</span>
                        }
                    </div>
                    <p class="text-muted reveal reveal-up" style="transition-delay: 250ms;">@product.Description</p>

                    <div class="mb-3 reveal reveal-up" style="transition-delay: 320ms;">
                        <label for="variant" class="form-label">Variant</label>
                        <select id="variant" class="form-select">
                            @foreach (var variant in product.Variants)
                            {
                                <option value="@variant.Name" data-price="@variant.Price">@variant.Name - @string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-IN"), "₹{0:N0}", variant.Price)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3 reveal reveal-up" style="transition-delay: 390ms;">
                        <label class="form-label">Quantity</label><br />
                        <partial name="Partials/_QuantitySelector" model='("productQuantity", 1)' />
                    </div>

                    <div class="d-flex gap-2 mb-4 reveal reveal-up" style="transition-delay: 460ms;">
                        <button type="button"
                                class="btn btn-dark js-add-to-cart"
                                data-product-id="@product.Id"
                                data-product-name="@product.Name"
                                data-product-price="@product.Price"
                                data-product-image="@(product.Images.FirstOrDefault() ?? "/images/products/placeholder-product.webp")"
                                data-product-slug="@product.Slug"
                                data-variant-select-id="variant"
                                data-quantity-input-id="productQuantity">Add to Cart</button>
                        <a asp-page="/Checkout" class="btn btn-success">Buy via WhatsApp</a>
                    </div>

                    <section class="rounded-4 p-3 bg-white shadow-sm reveal reveal-up" style="transition-delay: 530ms;">
                        <h2 class="h6">Product Information</h2>
                        <p class="mb-1"><strong>Ingredients:</strong> @product.Ingredients</p>
                        <p class="mb-1"><strong>Shelf life:</strong> @product.ShelfLife</p>
                        <p class="mb-0"><strong>Storage:</strong> @product.StorageInstructions</p>
                    </section>
                </div>
            </div>
        </div>
    </section>
}
