@page "/cart"
@model MangalFoods.Pages.CartModel

<section class="py-4 py-lg-5">
    <div class="container-xl">
        <h1 class="h2 mb-4 reveal reveal-up">Your Cart</h1>
        <div class="row g-4">
            <div class="col-lg-8">
                <div id="cartItemsContainer" class="d-grid gap-3" aria-live="polite"></div>
                <div id="cartEmptyState" class="empty-state p-4 text-center d-none">
                    <h2 class="h5">Your cart is empty</h2>
                    <p class="text-muted">Add premium sweets and savouries to continue.</p>
                    <a asp-page="/Shop" class="btn btn-dark">Continue Shopping</a>
                </div>
                <button id="clearCartButton" type="button" class="btn btn-outline-dark mt-3">Clear Cart</button>
            </div>
            <div class="col-lg-4">
                <partial name="Partials/_CartSummary" />
                <a asp-page="/Checkout" class="btn btn-dark w-100 mt-3">Proceed to Checkout</a>
            </div>
        </div>
    </div>
</section>

