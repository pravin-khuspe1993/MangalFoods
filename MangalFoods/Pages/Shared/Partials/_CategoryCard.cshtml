@model (string Name, string Description, string Image, string Link)

<article class="category-card h-100 reveal reveal-up">
    <a href="@Model.Link" class="text-decoration-none" aria-label="Browse @Model.Name">
        <img src="@Model.Image" class="img-fluid category-card-image" alt="@Model.Name category" loading="lazy" />
        <div class="p-3">
            <h3 class="h5 mb-2 text-dark">@Model.Name</h3>
            <p class="text-muted mb-0">@Model.Description</p>
            <span class="small fw-semibold text-dark d-inline-flex align-items-center gap-1 mt-2">Explore <i class="bi bi-arrow-right-short category-arrow" aria-hidden="true"></i></span>
        </div>
    </a>
</article>
