@model MangalFoods.Configuration.SiteSettings

<footer class="site-footer mt-5 reveal reveal-up" role="contentinfo">
    <div class="container-xl py-5">
        <div class="row g-4 reveal-stagger">
            <div class="col-lg-4">
                <h2 class="h5 mb-3">@Model.BusinessName</h2>
                <p class="text-muted mb-3">Premium Indian sweets, savouries, and gifting experiences crafted for celebration.</p>
                <p class="mb-1"><a href="tel:@Model.Phone">@Model.Phone</a></p>
                <p class="mb-1"><a href="mailto:@Model.Email">@Model.Email</a></p>
                <p class="text-muted mb-0">@Model.Address</p>
            </div>
            <div class="col-sm-6 col-lg-4">
                <h2 class="h6 text-uppercase mb-3">Quick Links</h2>
                <ul class="list-unstyled footer-links">
                    <li><a asp-page="/Shop">Shop</a></li>
                    <li><a asp-page="/Gifting">Gifting</a></li>
                    <li><a asp-page="/About">About</a></li>
                    <li><a asp-page="/FAQ">FAQ</a></li>
                    <li><a asp-page="/Contact">Contact</a></li>
                </ul>
            </div>
            <div class="col-sm-6 col-lg-4">
                <h2 class="h6 text-uppercase mb-3">Follow</h2>
                <div class="d-flex gap-3 mb-3">
                    <a href="@Model.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="@Model.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                </div>
                <form asp-page="/Contact" method="get" class="newsletter-form">
                    <label for="newsletterEmail" class="form-label">Newsletter</label>
                    <div class="input-group">
                        <input id="newsletterEmail" type="email" class="form-control" placeholder="Enter your email" aria-label="Email address" />
                        <button type="submit" class="btn btn-dark">Join</button>
                    </div>
                </form>
            </div>
        </div>
        <hr class="my-4" />
        <p class="small text-muted mb-0">&copy; @DateTime.UtcNow.Year @Model.BusinessName. All rights reserved.</p>
    </div>
</footer>
